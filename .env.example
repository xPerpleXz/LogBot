# Discord Bot Token (von https://discord.com/developers/applications)
DISCORD_TOKEN=dein_discord_bot_token_hier

# Google Sheets ID (aus der URL: https://docs.google.com/spreadsheets/d/DEINE_SHEET_ID/edit)
SPREADSHEET_ID=deine_google_sheets_id_hier

# Discord Channel IDs
LOG_OUTPUT_CHANNEL_ID=1234567890  # Channel wo Premium-Logs gepostet werden
REPORT_CHANNEL_ID=1234567890      # Channel für wöchentliche Reports

# 🌱 PLANTAGEN CHANNELS (NEU in v2.2.0)
PLANTAGEN_UPDATES_CHANNEL_ID=1234567890  # Channel für Plantagen-Status-Updates
PLANTAGEN_ERNTE_CHANNEL_ID=1234567890    # Channel für Ernte-Benachrichtigungen (@here Ping)

# Optional: Auszahlungs-Berechtigungen (Rollen-IDs, komma-separiert)
# Alternative: Nutze /config add-role im Discord
PAYOUT_ROLE_IDS=123456789,987654321

# Optional: Timezone
TZ=Europe/Berlin

# Optional: Google Credentials als Base64 (für Railway/Cloud Deployment)
# GOOGLE_CREDENTIALS_BASE64=dein_base64_string_hier
